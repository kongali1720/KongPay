# ============================================
# KongPay - Environment Variables Template
# ============================================
# Copy file ini jadi .env dan isi dengan nilai asli.
# JANGAN PERNAH commit file .env asli ke git.

PORT=8080
GIN_MODE=debug              # debug | release (pakai 'release' di production)

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=kongpay
DB_SSL_MODE=disable         # 'require' di production
DB_DISABLE=false

# --- Auth ---
# Generate dengan: openssl rand -hex 32
JWT_SECRET=changeme_generate_with_openssl_rand_hex_32

# --- Logging ---
LOG_LEVEL=info               # debug | info | warn | error
LOG_FILE=./kongpay.log
