# ============================================
# KongPay - Crypto Module Environment Template
# ============================================
# JANGAN PERNAH isi file .env.crypto asli dengan nilai di bawah ini.
# WALLET_HD_SEED & WALLET_ENCRYPTION_KEY WAJIB pakai KMS/HSM di production,
# jangan simpan plaintext bahkan di server sendiri.

# --- Ethereum ---
ETH_ENABLED=false
ETH_RPC_URL=https://mainnet.infura.io/v3/your_project_id
ETH_WS_URL=wss://mainnet.infura.io/ws/v3/your_project_id
ETH_CHAIN_ID=1
ETH_MIN_CONFIRMATIONS=12

# --- BSC ---
BSC_ENABLED=false
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_WS_URL=
BSC_CHAIN_ID=56
BSC_MIN_CONFIRMATIONS=15

# --- Polygon ---
POLYGON_ENABLED=false
POLYGON_RPC_URL=
POLYGON_WS_URL=
POLYGON_CHAIN_ID=137
POLYGON_MIN_CONFIRMATIONS=128

# --- Bitcoin ---
BTC_ENABLED=false
BTC_NETWORK=mainnet          # mainnet | testnet
BTC_RPC_URL=
BTC_RPC_USER=
BTC_RPC_PASSWORD=changeme
BTC_MIN_CONFIRMATIONS=3

# --- Solana ---
SOLANA_ENABLED=false
SOLANA_RPC_URL=
SOLANA_WS_URL=
SOLANA_MIN_CONFIRMATIONS=32

# --- Wallet (SANGAT SENSITIF - lihat catatan di atas) ---
WALLET_HD_SEED=changeme_never_commit_use_kms_in_production
WALLET_DERIVATION_PATH=m/44'/60'/0'/0
WALLET_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32
WALLET_MNEMONIC_PATH=/secure/path/outside/repo

# --- Tokens ---
TOKEN_USDT_ENABLED=false
TOKEN_USDT_CONTRACT=
TOKEN_USDC_ENABLED=false
TOKEN_USDC_CONTRACT=
TOKEN_DAI_ENABLED=false
TOKEN_DAI_CONTRACT=
TOKEN_KAC_ENABLED=false
TOKEN_KAC_CONTRACT=

# --- Monitoring ---
MONITOR_SCAN_INTERVAL=15s
MONITOR_MAX_RETRY=3
MONITOR_ALERT_ON_CONFIRMATION=true
MONITOR_ALERT_ON_FAILURE=true

# --- Security ---
SECURITY_ENCRYPT_PRIVATE_KEYS=true
SECURITY_ALLOWED_NETWORKS=mainnet
SECURITY_BLACKLISTED_ADDRESSES=

# --- Third party ---
ETHERSCAN_API_KEY=changeme
